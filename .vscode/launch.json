{
  // Configuraciones para ejecutar desde "Ejecutar y depurar" (F5).
  // Pon las pistas en la carpeta audio/ con estos nombres, o cámbialos aquí.
  "version": "0.2.0",
  "inputs": [
    {
      "id": "umbral",
      "type": "promptString",
      "description": "Umbral mínimo en dBFS (usa el que sugiere 'Analizar pistas')",
      "default": "-27"
    },
    {
      "id": "salida",
      "type": "promptString",
      "description": "Nombre del vídeo de salida",
      "default": "episodio.mp4"
    }
  ],
  "configurations": [
    {
      "name": "1. Analizar pistas",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ranas.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--a", "audio/A.mp3", "--b", "audio/B.mp3", "--analizar"]
    },
    {
      "name": "2. Prueba (1 minuto, eventos frecuentes)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ranas.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--a", "audio/A.mp3", "--b", "audio/B.mp3", "--mezcla", "audio/master.mp3",
               "--umbral", "${input:umbral}", "--duracion", "60", "--eventos-cada", "8",
               "-o", "prueba.mp4"]
    },
    {
      "name": "3. Episodio completo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ranas.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--a", "audio/A.mp3", "--b", "audio/B.mp3", "--mezcla", "audio/master.mp3",
               "--umbral", "${input:umbral}", "-o", "${input:salida}"]
    },
    {
      "name": "Episodio con MIDI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ranas.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--a", "audio/A.mp3", "--b", "audio/B.mp3", "--mezcla", "audio/master.mp3",
               "--umbral", "${input:umbral}", "--midi", "audio/gags.mid",
               "-o", "${input:salida}"]
    },
    {
      "name": "Vista previa del fondo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/escena.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
